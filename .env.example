# CloudSync Environment Configuration
# Copy this file to .env and fill in the values

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloudsync
DB_USERNAME=cloudsync
DB_PASSWORD=your_secure_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# AWS S3
AWS_REGION=us-east-1
AWS_S3_BUCKET=cloudsync-files
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY=your_access_key
AWS_SECRET_KEY=your_secret_key

# JWT
JWT_SECRET=your-super-secret-jwt-key-at-least-256-bits-long-for-hs256

# Upload
UPLOAD_TEMP_DIR=/tmp/cloudsync-uploads

# Storage Nodes (for consistent hashing)
STORAGE_NODES=node1,node2,node3
