# ============================================
# CloudSync Production Environment Variables
# Copy this to .env and fill in the values
# ============================================

# ---- Database (AWS RDS) ----
DB_HOST=cloudsync-db.xxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=cloudsync
DB_USERNAME=admin
DB_PASSWORD=YourSecurePassword123

# ---- Redis (Optional - leave empty to disable) ----
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- AWS S3 ----
AWS_REGION=us-east-1
AWS_S3_BUCKET=cloudsync-files-YOURNAME
AWS_ACCESS_KEY=AKIAXXXXXXXXXXXXXXXXX
AWS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- JWT (Generate with: openssl rand -base64 64) ----
JWT_SECRET=YourSecureJwtSecretKeyThatIsAtLeast64CharactersLongBase64EncodedHere12345
